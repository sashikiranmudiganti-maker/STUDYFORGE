{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Student profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "collegeName": { "type": "string", "maxLength": 200 },
        "course": { "type": "string", "maxLength": 100 },
        "academicYear": { "type": "string", "maxLength": 50 },
        "semester": { "type": "string", "maxLength": 50 },
        "sleepDurationHours": { "type": "number" },
        "collegeStart": { "type": "string", "maxLength": 10 },
        "collegeEnd": { "type": "string", "maxLength": 10 },
        "dailyStudyTargetHours": { "type": "number" },
        "preparationLevel": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "email"]
    },
    "Subject": {
      "title": "Academic Subject",
      "description": "Subjects belonging to a student",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "code": { "type": "string", "maxLength": 50 },
        "examDate": { "type": "string", "maxLength": 50 },
        "examTime": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "units": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name"]
    },
    "StudySession": {
      "title": "Study Session",
      "description": "Individual study session or task generated by AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectId": { "type": "string", "maxLength": 100 },
        "subjectName": { "type": "string", "maxLength": 150 },
        "unit": { "type": "string", "maxLength": 150 },
        "topic": { "type": "string", "maxLength": 250 },
        "date": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "durationMinutes": { "type": "number" },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "status": { "type": "string", "enum": ["pending", "completed", "missed"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "completedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "subjectName", "topic", "date", "startTime", "endTime", "status"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "Flashcard for revision and active recall",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectName": { "type": "string", "maxLength": 150 },
        "unit": { "type": "string", "maxLength": 150 },
        "topic": { "type": "string", "maxLength": 250 },
        "front": { "type": "string", "maxLength": 1000 },
        "back": { "type": "string", "maxLength": 2000 },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "status": { "type": "string", "enum": ["new", "learning", "mastered", "review"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "subjectName", "front", "back"]
    },
    "QuizAttempt": {
      "title": "Quiz or Mock Exam Attempt",
      "description": "Records of completed practice tests and mock exams",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "subjectName": { "type": "string", "maxLength": 150 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "accuracyPercentage": { "type": "number" },
        "weakTopics": { "type": "string" },
        "feedback": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "score", "totalQuestions"]
    },
    "SavedMaterial": {
      "title": "Saved Study Material",
      "description": "Notes, formula sheets, and bookmarked explanations",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectName": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["Notes", "Formulas", "Questions", "Summary", "Explanations"] },
        "content": { "type": "string" },
        "tags": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "category", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Student user profiles indexed by Auth UID"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Student academic subjects and exam dates"
    },
    "/study_sessions/{sessionId}": {
      "schema": "StudySession",
      "description": "Scheduled study tasks and timetables"
    },
    "/flashcards/{flashcardId}": {
      "schema": "Flashcard",
      "description": "Student revision flashcards"
    },
    "/quiz_attempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "Practice test and mock exam evaluations"
    },
    "/saved_materials/{materialId}": {
      "schema": "SavedMaterial",
      "description": "Student study library materials"
    }
  }
}
